{
  "name": "@ccgmon/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/events.js",
  "types": "./dist/events.d.ts",
  "exports": {
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  },
  "vitest": {
    "include": [
      "test/**/*.test.ts"
    ]
  }
}
